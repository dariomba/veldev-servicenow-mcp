# ServiceNow instance
SN_INSTANCE=https://your-instance.service-now.com

# Basic auth (default)
SN_USERNAME=admin
SN_PASSWORD=...

# OAuth (set SN_AUTH_TYPE=oauth and fill in client credentials)
# SN_AUTH_TYPE=oauth
# SN_CLIENT_ID=...
# SN_CLIENT_SECRET=...
# SN_GRANT_TYPE=password        # or client_credentials

# Server options
PORT=3000
TRANSPORT=http        # http (default) or stdio

# Advanced: credential provider (default: env for local dev)
# CREDENTIAL_PROVIDER=env
# GATEWAY_SECRET=...  # required when CREDENTIAL_PROVIDER=header
